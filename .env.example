PORT=3100

R2_BUCKET=fluencybe-episode-videos
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# portalfluencybe's base URL for the transcode callback, e.g. https://portal.fluencybe.com/api
TRANSCODE_CALLBACK_URL=http://localhost:8000/api
# Shared secret — must match TRANSCODER_CALLBACK_TOKEN in portalfluencybe's .env
TRANSCODE_CALLBACK_TOKEN=change-me
