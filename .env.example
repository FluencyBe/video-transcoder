PORT=3100

R2_BUCKET=fluencybe-episode-videos
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# fluency-api's base URL for the transcode callback (ADR 0010 — fluency-api is now
# the single writer of episode_video_transcodes), e.g. https://fluency-api.fluencybe.com.br/api/v1
TRANSCODE_CALLBACK_URL=http://localhost:3004/api/v1
# Shared secret — must match TRANSCODE_CALLBACK_TOKEN in fluency-api's .env
TRANSCODE_CALLBACK_TOKEN=change-me
